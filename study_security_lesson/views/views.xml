<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_study_security_lesson_list" model="ir.ui.view">
        <field name="name">study.security.lesson.list</field>
        <field name="model">study.security.lesson</field>
        <field name="arch" type="xml">
            <list string="Security Lessons">
                <field name="name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_study_security_lesson_form" model="ir.ui.view">
        <field name="name">study.security.lesson.form</field>
        <field name="model">study.security.lesson</field>
        <field name="arch" type="xml">
            <form string="Security Lesson">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_study_security_lesson" model="ir.actions.act_window">
        <field name="name">Security Lessons</field>
        <field name="res_model">study.security.lesson</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
