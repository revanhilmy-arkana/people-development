<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Display Name Views -->
    <record id="view_study_display_name_form" model="ir.ui.view">
        <field name="name">study.display.name.form</field>
        <field name="model">study.display.name</field>
        <field name="arch" type="xml">
            <form string="Display Name">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_study_display_name_list" model="ir.ui.view">
        <field name="name">study.display.name.list</field>
        <field name="model">study.display.name</field>
        <field name="arch" type="xml">
            <list string="Display Names">
                <field name="display_name"/> <!-- This will show the formatted [CODE] NAME -->
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- 2. Reference Views -->
    <record id="view_study_display_reference_form" model="ir.ui.view">
        <field name="name">study.display.reference.form</field>
        <field name="model">study.display.reference</field>
        <field name="arch" type="xml">
            <form string="Reference">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="display_record_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_study_display_reference_list" model="ir.ui.view">
        <field name="name">study.display.reference.list</field>
        <field name="model">study.display.reference</field>
        <field name="arch" type="xml">
            <list string="References">
                <field name="name"/>
                <field name="display_record_id"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_study_display_name" model="ir.actions.act_window">
        <field name="name">Display Name Records</field>
        <field name="res_model">study.display.name</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_study_display_reference" model="ir.actions.act_window">
        <field name="name">Reference Records</field>
        <field name="res_model">study.display.reference</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
