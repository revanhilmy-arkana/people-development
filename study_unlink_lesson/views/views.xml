<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_study_unlink_lesson_form" model="ir.ui.view">
        <field name="name">study.unlink.lesson.form</field>
        <field name="model">study.unlink.lesson</field>
        <field name="arch" type="xml">
            <form string="Unlink Lesson">
                <header>
                    <!-- Clickable statusbar to easily test both states -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,locked" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_study_unlink_lesson_list" model="ir.ui.view">
        <field name="name">study.unlink.lesson.list</field>
        <field name="model">study.unlink.lesson</field>
        <field name="arch" type="xml">
            <list string="Unlink Lessons">
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-danger="state == 'locked'"/>
            </list>
        </field>
    </record>

    <record id="action_study_unlink_lesson" model="ir.actions.act_window">
        <field name="name">Unlink Lesson</field>
        <field name="res_model">study.unlink.lesson</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
