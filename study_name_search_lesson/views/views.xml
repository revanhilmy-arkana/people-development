<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Search Target Views -->
    <record id="view_study_name_search_target_form" model="ir.ui.view">
        <field name="name">study.name.search.target.form</field>
        <field name="model">study.name.search.target</field>
        <field name="arch" type="xml">
            <form string="Target">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="identification_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_study_name_search_target_list" model="ir.ui.view">
        <field name="name">study.name.search.target.list</field>
        <field name="model">study.name.search.target</field>
        <field name="arch" type="xml">
            <list string="Targets">
                <field name="name"/>
                <field name="identification_id"/>
            </list>
        </field>
    </record>

    <!-- 2. Reference Views -->
    <record id="view_study_name_search_reference_form" model="ir.ui.view">
        <field name="name">study.name.search.reference.form</field>
        <field name="model">study.name.search.reference</field>
        <field name="arch" type="xml">
            <form string="Reference">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="target_id" placeholder="Type name or ID Code..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_study_name_search_target" model="ir.actions.act_window">
        <field name="name">Targets</field>
        <field name="res_model">study.name.search.target</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_study_name_search_reference" model="ir.actions.act_window">
        <field name="name">References</field>
        <field name="res_model">study.name.search.reference</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
