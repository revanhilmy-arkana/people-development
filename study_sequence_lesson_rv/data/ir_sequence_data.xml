<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_purchase_order_ppn" model="ir.sequence">
            <field name="name">Purchase Order PPN</field>
            <field name="code">purchase.order.ppn</field>
            <!-- <field name="prefix">PO/PPN/%(Y)s/%(month)s/</field> -->
            <field name="prefix">PO/PPN/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_purchase_order_non_ppn" model="ir.sequence">
            <field name="name">Purchase Order Non PPN</field>
            <field name="code">purchase.order.non.ppn</field>
            <!-- <field name="prefix">PO/%(Y)s/%(month)s/</field> -->
            <field name="prefix">PO/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
