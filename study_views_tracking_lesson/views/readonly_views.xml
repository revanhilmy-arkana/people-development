<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Define a NEW list view with create="0" -->
    <record id="view_study_views_tracking_list_readonly" model="ir.ui.view">
        <field name="name">study.views.tracking.list.readonly</field>
        <field name="model">study.views.tracking</field>
        <field name="arch" type="xml">
            <list string="Lessons (Read Only)" create="0" delete="0">
                <field name="name"/>
                <field name="age"/>
                <field name="gender"/>
            </list>
        </field>
    </record>

    <!-- 2. Define a NEW action that uses view_ids to point to this specific view -->
    <record id="action_study_views_tracking_readonly" model="ir.actions.act_window">
        <field name="name">View Only Lessons</field>
        <field name="res_model">study.views.tracking</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_study_views_tracking_list_readonly')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_study_views_tracking_form')})]"/>
    </record>
</odoo>
