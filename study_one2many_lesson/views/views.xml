<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_study_one2many_lesson_form" model="ir.ui.view">
        <field name="name">study.one2many.lesson.form</field>
        <field name="model">study.one2many.lesson</field>
        <field name="arch" type="xml">
            <form string="One2many Lesson">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Odoo Development Course"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>

                    <notebook>
                        <page string="Topics" name="topics">
                            <!-- One2many field displayed as an editable list -->
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_study_one2many_lesson_list" model="ir.ui.view">
        <field name="name">study.one2many.lesson.list</field>
        <field name="model">study.one2many.lesson</field>
        <field name="arch" type="xml">
            <list string="One2many Lessons">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_study_one2many_lesson" model="ir.actions.act_window">
        <field name="name">One2many Lesson</field>
        <field name="res_model">study.one2many.lesson</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
